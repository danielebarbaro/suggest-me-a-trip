<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>🗺️ Daily Available Itineraries Report - {{ "now"|date("d F Y") }}</title>
    <style>
        {% include 'emails/_components/email-styles.twig' %}
        {% include 'emails/_components/itineraries-styles.twig' %}
    </style>
</head>
<body>
    <div class="container">
        {% include 'emails/_components/header.twig' with {
            'title': 'Daily Available Itineraries',
            'date': "now"|date("l, F j, Y")
        } %}

        {% if filterCountry %}
            <div class="filter-info">
                🔍 Filtered by country: <span class="highlight">{{ filterCountry|upper }}</span>
            </div>
        {% endif %}

        <div class="content">
            <p class="intro-text">
                Discover your next adventure with our carefully curated itineraries. Each route offers unique experiences and stunning destinations.
            </p>
            
            {% set totalItineraries = 0 %}
            {% set totalTrips = 0 %}
            
            {% for itinerary in groupedItineraries %}
                {% set totalItineraries = totalItineraries + 1 %}
                {% set totalTrips = totalTrips + itinerary.trips|length %}
            {% endfor %}
            
            {% include 'emails/_components/stats-section.twig' with {
                'stats': [
                    {'number': totalItineraries, 'label': 'Available Itineraries'},
                    {'number': totalTrips, 'label': 'Total Trips'},
                    {'number': totalItineraries > 0 ? (totalTrips/totalItineraries)|round(0) : 0, 'label': 'Avg Trips per Route'}
                ]
            } %}
            
            <div class="itineraries-section">
                <h2 class="section-title">Available Routes</h2>
                
                {% for itinerary in groupedItineraries %}
                    <div class="itinerary">
                        <div class="itinerary-header">
                            <span>{{ itinerary.title }}</span>
                            <span>{{ itinerary.trips|length }} trips</span>
                        </div>

                        {% for trip in itinerary.trips %}
                            <div class="trip">
                                <div class="trip-title">{{ trip.title }}</div>
                                <div class="trip-details">
                                    <div class="trip-dates">
                                        📅 <strong>{{ trip.timeframes.startDate }} → {{ trip.timeframes.endDate }}</strong>
                                    </div>
                                    <div class="distance">
                                        {{ trip.timeframes.distance }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
        
        {% include 'emails/_components/footer.twig' %}
    </div>
</body>
</html>
