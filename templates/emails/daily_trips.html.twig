<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>🚐 Daily Available Trips Report - {{ "now"|date("d F Y") }}</title>
</head>
<body style="margin: 0; padding: 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; line-height: 1.6; color: #313b00; background: #f5f5f5;">
    <!-- Main Container -->
    <table align="center" border="0" cellpadding="0" cellspacing="0" style="max-width: 720px; width: 100%; background: white; border-radius: 0;">
        
        <!-- Header -->
        <tr>
            <td style="background: #313b00; color: white; padding: 30px 40px;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td>
                            <h1 style="margin: 0; font-size: 2.2rem; font-weight: 700; color: white; margin-bottom: 5px;">Daily Available Trips</h1>
                            <div style="font-size: 1rem; color: #cccccc; font-weight: 400;">{{ "now"|date("l, F j, Y") }}</div>
                        </td>
                        <td width="60" style="text-align: center;">
                            <div style="width: 60px; height: 60px; background: white; border-radius: 50%; display: inline-block; line-height: 60px; font-size: 2.5rem; text-align: center;">🚌</div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- Content -->
        <tr>
            <td style="padding: 50px 40px; background: white;">
                
                <!-- Intro Text -->
                <p style="font-size: 1.1rem; color: #666666; margin: 0 0 40px 0; line-height: 1.6;">
                    We've found several available trips for today. Here's a summary of what's currently available for booking.
                </p>

                <!-- Stats Calculation -->
                {% set totalTrips = 0 %}
                {% set totalDistance = 0 %}
                {% for dateRange, trips in groupedTrips %}
                    {% set totalTrips = totalTrips + trips|length %}
                    {% for trip in trips %}
                        {% set totalDistance = totalDistance + trip.length %}
                    {% endfor %}
                {% endfor %}

                <!-- Stats Section -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background: #f6f1e7; color: #313b00; margin: 40px 0;">
                    <tr>
                        <td style="padding: 30px;">
                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                <tr>
                                    <td width="33%" style="text-align: center; padding: 0 15px;">
                                        <div style="font-size: 2.5rem; font-weight: 700; color: #313b00; margin-bottom: 5px;">{{ totalTrips }}</div>
                                        <div style="color: #666666; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Available Trips</div>
                                    </td>
                                    <td width="33%" style="text-align: center; padding: 0 15px;">
                                        <div style="font-size: 2.5rem; font-weight: 700; color: #313b00; margin-bottom: 5px;">{{ totalTrips > 0 ? (totalDistance/totalTrips)|round(0) : 0 }}</div>
                                        <div style="color: #666666; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Avg Distance (km)</div>
                                    </td>
                                    <td width="33%" style="text-align: center; padding: 0 15px;">
                                        <div style="font-size: 2.5rem; font-weight: 700; color: #313b00; margin-bottom: 5px;">{{ groupedTrips|length }}</div>
                                        <div style="color: #666666; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;">Time Periods</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Trips Section -->
                <h2 style="font-size: 1.3rem; font-weight: 600; color: #313b00; margin: 50px 0 30px 0; text-align: center;">Available Trips by Date</h2>

                {% for dateRange, trips in groupedTrips %}
                    <!-- Date Group -->
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 40px 0;">
                        
                        <!-- Date Header -->
                        <tr>
                            <td style="background: #bed255; color: #313b00; padding: 15px 25px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td style="font-size: 1.1rem; font-weight: 600;">{{ dateRange }}</td>
                                        <td style="text-align: right; font-size: 1.1rem; font-weight: 600;">{{ trips|length }} trips</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Trips -->
                        {% for trip in trips %}
                            <tr>
                                <td style="padding: 25px; {% if not loop.last %}border-bottom: 1px solid #eeeeee;{% endif %} background: white;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                        <tr>
                                            <td width="30" style="vertical-align: top;">
                                                <div style="background: #EC4899; color: #f5f5f5; width: 30px; height: 30px; border-radius: 50%; text-align: center; line-height: 30px; font-weight: 600; font-size: 0.8rem;">{{ loop.index }}</div>
                                            </td>
                                            <td style="padding-left: 20px; vertical-align: top;">
                                                <div style="font-size: 1.1rem; color: #313b00; font-weight: 500; margin-bottom: 5px;">{{ trip.pickupStation.fullName }} → {{ trip.dropoffStation.fullName }}</div>
                                            </td>
                                            <td width="80" style="text-align: right; vertical-align: top;">
                                                <div style="background: #7b8303; color: #ffffff; padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 600; display: inline-block;">{{ trip.length|round(0) }} km</div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                {% endfor %}

            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="background: #f6f1e7; padding: 40px; text-align: center; color: #432205; font-size: 0.9rem;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td style="text-align: center;">
                            <div style="font-size: 0.7rem; margin-bottom: 15px;">
                                <span style="color: #999999;">Generated on {{ "now"|date("Y-m-d H:i:s") }}</span>
                                <span style="color: #999999; margin: 0 10px;">•</span>
                                <span style="color: #999999;">Powered by</span>
                                <a href="https://www.plincode.tech/" class="plin-code-logo" target="_blank">
                                    <img alt="Plin Code Logo" height="20px" src="data:image/png;base64," />
                                </a>
                                <a href="https://www.plincode.tech/" style="color: #313b00; text-decoration: none; font-weight: 500; margin-left: 5px;" target="_blank">Plin Code</a>
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

    </table>
</body>
</html>
