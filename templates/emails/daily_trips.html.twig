<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>🚐 Daily Available Trips Report - {{ "now"|date("d F Y") }}</title>
    <style>
        {% include 'emails/_components/email-styles.twig' %}
        {% include 'emails/_components/trips-styles.twig' %}
    </style>
</head>
<body>
    <div class="container">
        {% include 'emails/_components/header.twig' with {
            'title': 'Daily Available Trips',
            'date': "now"|date("l, F j, Y")
        } %}

        <div class="content">
            <p class="intro-text">
                We've found several available trips for today. Here's a summary of what's currently available for booking.
            </p>

            {% set totalTrips = 0 %}
            {% set totalDistance = 0 %}

            {% for dateRange, trips in groupedTrips %}
                {% set totalTrips = totalTrips + trips|length %}
                {% for trip in trips %}
                    {% set totalDistance = totalDistance + trip.length %}
                {% endfor %}
            {% endfor %}

            {% include 'emails/_components/stats-section.twig' with {
                'stats': [
                    {'number': totalTrips, 'label': 'Available Trips'},
                    {'number': (totalDistance/totalTrips)|round(0), 'label': 'Avg Distance (km)'},
                    {'number': groupedTrips|length, 'label': 'Time Periods'}
                ]
            } %}

            <div class="trips-section">
                <h2 class="section-title">Available Trips by Date</h2>

                {% for dateRange, trips in groupedTrips %}
                    <div class="date-group">
                        <div class="date-header">
                            <span>{{ dateRange }}</span>
                            <span>{{ trips|length }} trips</span>
                        </div>

                        {% for trip in trips %}
                            <div class="trip">
                                <div class="trip-number">{{ loop.index }}</div>
                                <div class="trip-content">
                                    <div class="trip-route">{{ trip.pickupStation.fullName }} → {{ trip.dropoffStation.fullName }}</div>
                                </div>
                                <div class="trip-distance">{{ trip.length|round(0) }} km</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>

        {% include 'emails/_components/footer.twig' %}
    </div>
</body>
</html>
