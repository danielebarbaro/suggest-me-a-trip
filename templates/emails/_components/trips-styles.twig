        .trips-section {
            margin-top: 50px;
        }

        .date-group {
            margin: 40px 0;
        }

        .date-header {
            background: #bed255;
            color: #313b00;
            padding: 15px 25px;
            font-size: 1.1rem;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .trip {
            padding: 25px;
            border-bottom: 1px solid #eeeeee;
            display: flex;
            align-items: center;
            gap: 20px;
            background: white;
        }

        .trip:last-child {
            border-bottom: none;
        }

        .trip-number {
            background: #EC4899FF;
            color: #f5f5f5;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .trip-content {
            flex: 1;
        }

        .trip-route {
            font-size: 1.1rem;
            color: #313b00;
            font-weight: 500;
            margin-bottom: 5px;
        }

        .trip-details {
            color: #666666;
            font-size: 0.9rem;
        }

        .trip-distance {
            background: #7b8303;
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .trip {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }
        } 