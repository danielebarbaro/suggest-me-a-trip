        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #313b00;
            background: #f5f5f5;
            padding: 40px 20px;
        }

        .container {
            max-width: 720px;
            margin: 0 auto;
            background: white;
            border-radius: 0;
            overflow: hidden;
        }

        .header {
            background: #313b00;
            color: white;
            padding: 30px 40px;
            text-align: left;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0;
        }

        .header-content {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .header-title {
            font-size: 1.1rem;
            font-weight: 500;
            color: #cccccc;
        }

        .logo-area {
            width: 60px;
            height: 60px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            flex-shrink: 0;
        }

        .logo-area img {
            width: 40px;
            height: auto;
        }

        .header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 5px;
        }

        .header .subtitle {
            font-size: 1rem;
            color: #cccccc;
            font-weight: 400;
        }

        .content {
            padding: 50px 40px;
            background: white;
        }

        .intro-text {
            font-size: 1.1rem;
            color: #666666;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .stats-section {
            background: #f6f1e7;
            color: #313b00;
            padding: 30px;
            margin: 40px -40px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 30px;
            text-align: center;
        }

        .stat-card {
            background: transparent;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #313b00;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #666666;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .section-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #313b00;
            margin-bottom: 30px;
            text-align: center;
        }

        .footer {
            background: #f6f1e7;
            padding: 40px;
            text-align: center;
            color: #432205;
            font-size: 0.9rem;
        }

        .footer-content {
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .plin-code-logo {
            width: 32px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .plin-code-logo img {
            width: 100%;
            height: auto;
            max-height: 24px;
        }

        .footer-text {
            color: #999999;
        }

        .footer-link {
            color: #313b00;
            text-decoration: none;
            font-weight: 500;
        }

        .footer-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 768px) {
            body {
                padding: 20px 10px;
            }
            
            .content {
                padding: 30px 20px;
            }
            
            .stats-section {
                margin: 30px -20px;
                padding: 20px;
            }
            
            .stats {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .footer-content {
                flex-direction: column;
                gap: 10px;
            }
        } 