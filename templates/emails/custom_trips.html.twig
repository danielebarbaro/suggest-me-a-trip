<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Your custom trips</title>
</head>
<body style="font-family: Arial, sans-serif; color: #222;">
    <h1>Trip su misura</h1>
    <p>Ecco i viaggi che corrispondono ai tuoi filtri:</p>

    {% if trips is empty %}
        <p>Nessun viaggio trovato per i tuoi criteri.</p>
    {% else %}
        <table cellpadding="8" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%;">
            <thead>
                <tr style="background: #f3f3f3; text-align: left;">
                    <th>Tratta</th>
                    <th>Distanza</th>
                    <th>Periodo</th>
                </tr>
            </thead>
            <tbody>
                {% for trip in trips %}
                    <tr style="border-bottom: 1px solid #eee;">
                        <td>{{ trip.from }} &rarr; {{ trip.to }}</td>
                        <td>{{ trip.length }} km</td>
                        <td>{{ trip.start }} - {{ trip.end }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if unsubscribe_url %}
        <p style="margin-top: 24px; font-size: 12px; color: #888;">
            <a href="{{ unsubscribe_url }}">Disiscriviti</a>
        </p>
    {% endif %}
</body>
</html>
